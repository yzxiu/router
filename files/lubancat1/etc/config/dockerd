# dockerd UCI 配置 — 全量走 alt_config_file (完整 daemon.json)
#
# 原因: ImmortalWrt 的 /etc/init.d/dockerd 字段白名单不支持 bridge 等
# 选项 (只认 data_root/log_level/iptables/ip6tables/bip/log_driver/
# registry_mirrors/hosts/dns/ipv6/ip/fixed_cidr/storage_driver/proxies),
# option bridge 'none' 会被静默忽略。alt_config_file 让 init 直接软链
# /etc/docker/daemon.json, 绕过白名单, 所有 daemon.json 字段可用。
#
# daemon.json 内容 (见 /etc/docker/daemon.json):
#   iptables/ip6tables=false, bridge=none, ip-forward/ip-masq=false
#   → dockerd 不创建 docker0、不写任何 iptables/nft 规则
#     (配合 host 网络用法; bridge/端口映射能力按需无关)
#   log-driver=none: 容器日志不落盘, 走 docker logs 的仅内存 ring buffer
#     (dockerd 自身日志仍走 procd/syslog, 不受此影响)
#   proxies → 本机 sing-box mixed 入口 127.0.0.1:1087 (无凭据, 仅回环)
#     拉镜像走代理; 依赖 op_config 体系的 tproxy 配置含 mixed 入站

config globals 'globals'
	option alt_config_file '/etc/docker/daemon.json'
